<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
        <testsuite name="Integration">
            <directory>tests/Integration</directory>
        </testsuite>
        <testsuite name="Sandbox">
            <directory>tests/Sandbox</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <env name="APP_ENV" value="testing"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="BROADCAST_CONNECTION" value="null"/>
        <env name="CACHE_STORE" value="array"/>
        <!--
            Tests run against PostgreSQL, not SQLite.

            DevLab's schema depends on Postgres features that SQLite does not
            have: jsonb columns, GIN indexes, partial unique indexes (the guards
            that make double-awards impossible) and CHECK constraints. Testing
            on SQLite would be testing a database we do not ship.

            The cost is a running Postgres for `php artisan test`. That is the
            correct trade: an idempotency test that passes because SQLite
            silently ignored a partial unique index is worse than no test.
        -->
        <env name="INERTIA_SSR_ENABLED" value="false"/>
        <env name="DB_CONNECTION" value="pgsql"/>
        <env name="DB_HOST" value="127.0.0.1"/>
        <env name="DB_PORT" value="5433"/>
        <!--
             force, because PHPUnit leaves an <env> alone when the variable
             already exists in the real environment. The Docker containers set
             DB_DATABASE=devlab, so without this the suite silently connects to
             the DEVELOPMENT database and RefreshDatabase wipes it.

             Host and port are deliberately NOT forced: the suite runs both on
             the host (127.0.0.1:5433, the published port) and inside the app
             container (postgres:5432), and those defaults adapt. The database
             NAME is the one value that must never be inherited.
        -->
        <env name="DB_DATABASE" value="devlab_testing" force="true"/>
        <!--
             And again as a <server>, because Laravel's Env reads $_SERVER
             BEFORE $_ENV and getenv(), and PHPUnit's <env force> does not
             touch $_SERVER. PHP's variables_order copies the container's
             DB_DATABASE=devlab into $_SERVER, so the <env> above wins in
             getenv() and loses in config() — which is precisely how the suite
             managed to wipe the development database while reporting a pass.
        -->
        <server name="DB_DATABASE" value="devlab_testing" force="true"/>
        <env name="DB_USERNAME" value="devlab"/>
        <env name="DB_PASSWORD" value="change_me"/>
        <env name="DB_URL" value=""/>
        <!--
             Redis has the same hazard and the same shape of fix. The leaderboard
             integration tests run against a real Redis, and inheriting the
             development REDIS_DB put their sorted sets in the same keyspace the
             application reads. Nothing there is destroyed the way a truncated
             table is, but a rank written by a test is still a wrong rank.
        -->
        <env name="REDIS_DB" value="15" force="true"/>
        <server name="REDIS_DB" value="15" force="true"/>
        <env name="REDIS_CACHE_DB" value="14" force="true"/>
        <server name="REDIS_CACHE_DB" value="14" force="true"/>
        <env name="REDIS_HOST" value="127.0.0.1"/>
        <env name="REDIS_PORT" value="6380"/>
        <env name="MAIL_MAILER" value="array"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="SESSION_DRIVER" value="array"/>
        <env name="PULSE_ENABLED" value="false"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
        <env name="NIGHTWATCH_ENABLED" value="false"/>
    </php>
</phpunit>
