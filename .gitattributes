# Normalise line endings so Windows, macOS and Linux contributors produce identical diffs.
* text=auto eol=lf

# Shell scripts and container files must stay LF or they break inside Linux containers.
*.sh        text eol=lf
*.bash      text eol=lf
Dockerfile  text eol=lf
*.dockerfile text eol=lf

# Binary — never touch.
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.webp binary
*.avif binary
*.ico  binary
*.woff binary
*.woff2 binary
*.ttf  binary
*.otf  binary
*.pdf  binary

# Keep generated and vendored files out of diffs and language statistics.
/public/build/**  linguist-generated
composer.lock     -diff linguist-generated
package-lock.json -diff linguist-generated
