# DevLab environment — copy to .env and fill in.
# Never commit .env. Every value here is a safe placeholder.

# ── Application ───────────────────────────────────────────────────────────────
APP_NAME=DevLab
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=UTC

# ── Database (PostgreSQL — source of truth) ───────────────────────────────────
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=devlab
DB_USERNAME=devlab
DB_PASSWORD=change_me

# ── Redis (cache, queues, leaderboards, rate limiting) ────────────────────────
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=null

# ── Cache / session / queue ───────────────────────────────────────────────────
CACHE_STORE=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120
QUEUE_CONNECTION=redis

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_CHANNEL=stack
LOG_LEVEL=debug

# ── Mail ──────────────────────────────────────────────────────────────────────
MAIL_MAILER=log
MAIL_FROM_ADDRESS="noreply@devlab.local"
MAIL_FROM_NAME="${APP_NAME}"

# ── Progression tuning (mirrors config/devlab.php defaults) ───────────────────
DEVLAB_XP_EASY=50
DEVLAB_XP_MEDIUM=100
DEVLAB_XP_HARD=200
DEVLAB_XP_EXPERT=500

# ── Rate limits (requests per minute) ─────────────────────────────────────────
DEVLAB_RATELIMIT_AUTH=5
DEVLAB_RATELIMIT_SUBMISSION=30
DEVLAB_RATELIMIT_AI=10
DEVLAB_RATELIMIT_COMMUNITY=5

# ── AI (Phase 5 — leave unset until then) ─────────────────────────────────────
# Provider is abstracted; see docs/adr/0004-ai-provider.md before enabling.
AI_ENABLED=false
AI_PROVIDER=
AI_API_KEY=
AI_CHAT_MODEL=
AI_MAX_TOKENS_PER_REQUEST=2000
AI_USER_DAILY_TOKEN_QUOTA=50000

# ── Embeddings / RAG (Phase 6) ────────────────────────────────────────────────
# Do not set a dimension before ADR 0005 chooses the model.
EMBEDDING_ENABLED=false
EMBEDDING_PROVIDER=
EMBEDDING_MODEL=
EMBEDDING_DIMENSIONS=

# ── Sandbox (Phase 3 — requires ADR 0006 and a security review) ───────────────
SANDBOX_ENABLED=false
SANDBOX_DRIVER=
SANDBOX_TIMEOUT_SECONDS=10
SANDBOX_MEMORY_LIMIT_MB=256
SANDBOX_CPU_LIMIT=0.5
SANDBOX_PID_LIMIT=64
SANDBOX_NETWORK_ENABLED=false
SANDBOX_MAX_OUTPUT_BYTES=65536
SANDBOX_USER_CONCURRENCY=1

# ── Frontend ──────────────────────────────────────────────────────────────────
VITE_APP_NAME="${APP_NAME}"
