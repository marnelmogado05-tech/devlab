# DevLab environment — copy to .env and fill in.
# Never commit .env. Every value here is a safe placeholder.
#
# Hostnames below are the Docker Compose service names. Running outside Docker?
# Use 127.0.0.1 for DB_HOST and REDIS_HOST.

# ── Application ───────────────────────────────────────────────────────────────
APP_NAME=DevLab
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

BCRYPT_ROUNDS=12

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ── Database (PostgreSQL — source of truth) ───────────────────────────────────
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=devlab
DB_USERNAME=devlab
DB_PASSWORD=change_me

# ── Redis (cache, queues, leaderboards, rate limiting) ────────────────────────
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=null

# ── Cache / session / queue ───────────────────────────────────────────────────
# Redis is a cache, a queue and a leaderboard index — never the only home of
# critical data. See plan §23 and docs/architecture/overview.md.
CACHE_STORE=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
QUEUE_CONNECTION=redis
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# ── Mail ──────────────────────────────────────────────────────────────────────
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@devlab.local"
MAIL_FROM_NAME="${APP_NAME}"

# ── Progression tuning (see config/devlab.php) ────────────────────────────────
DEVLAB_XP_EASY=50
DEVLAB_XP_MEDIUM=100
DEVLAB_XP_HARD=200
DEVLAB_XP_EXPERT=500
DEVLAB_XP_DAILY_BONUS=25

# ── Rate limits (requests per minute) ─────────────────────────────────────────
DEVLAB_RATELIMIT_AUTH=5
DEVLAB_RATELIMIT_ATTEMPT_START=20
DEVLAB_RATELIMIT_SUBMISSION=30
DEVLAB_RATELIMIT_BORED=30
DEVLAB_RATELIMIT_REPORT=5
DEVLAB_RATELIMIT_AI=10
DEVLAB_RATELIMIT_COMMUNITY=5

# ── AI (Phase 5 — leave disabled until then) ──────────────────────────────────
# Provider is abstracted; an ADR must record the choice before enabling.
AI_ENABLED=false
AI_PROVIDER=
AI_API_KEY=
AI_CHAT_MODEL=
AI_MAX_TOKENS_PER_REQUEST=2000
AI_USER_DAILY_TOKEN_QUOTA=50000

# ── Embeddings / RAG (Phase 6) ────────────────────────────────────────────────
# Do not set a dimension before an ADR chooses the model — a wrong guess means
# re-embedding the entire corpus (plan §28).
EMBEDDING_ENABLED=false
EMBEDDING_PROVIDER=
EMBEDDING_MODEL=
EMBEDDING_DIMENSIONS=

# ── Sandbox (Phase 3 — requires an ADR and a dedicated security review) ───────
SANDBOX_ENABLED=false
SANDBOX_DRIVER=
SANDBOX_TIMEOUT_SECONDS=10
SANDBOX_MEMORY_LIMIT_MB=256
SANDBOX_CPU_LIMIT=0.5
SANDBOX_PID_LIMIT=64
SANDBOX_NETWORK_ENABLED=false
SANDBOX_MAX_OUTPUT_BYTES=65536
SANDBOX_USER_CONCURRENCY=1

# ── AWS (unused today; kept for future object storage) ────────────────────────
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# ── Frontend ──────────────────────────────────────────────────────────────────
VITE_APP_NAME="${APP_NAME}"
