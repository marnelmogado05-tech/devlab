# DevLab environment — copy to .env. Never commit .env.
# Every value here is a safe placeholder.
#
# These defaults work BOTH inside Docker and on a local PHP install, with no
# editing. The app and queue containers have DB_HOST/REDIS_HOST overridden to
# the Compose service names in docker-compose.yml, so 127.0.0.1 here is what a
# local `php artisan` needs and is ignored where it would be wrong.
#
# Compose also reads this file: DB_DATABASE, DB_USERNAME and DB_PASSWORD below
# are what Postgres is initialised with on first boot. Change the password
# before this is reachable by anything but you.

# ── Application ───────────────────────────────────────────────────────────────
APP_NAME=DevLab
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

BCRYPT_ROUNDS=12

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ── Database (PostgreSQL — source of truth) ───────────────────────────────────
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5433
DB_DATABASE=devlab
DB_USERNAME=devlab
DB_PASSWORD=change_me

# ── Redis (cache, queues, leaderboards, rate limiting) ────────────────────────
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PORT=6380
REDIS_PASSWORD=null

# ── Cache / session / queue ───────────────────────────────────────────────────
# Redis is a cache, a queue and a leaderboard index — never the only home of
# critical data. See plan §23 and docs/architecture/overview.md.
CACHE_STORE=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
QUEUE_CONNECTION=redis
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# ── Mail ──────────────────────────────────────────────────────────────────────
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@devlab.local"
MAIL_FROM_NAME="${APP_NAME}"

# ── Progression tuning (see config/devlab.php) ────────────────────────────────
DEVLAB_XP_EASY=50
DEVLAB_XP_MEDIUM=100
DEVLAB_XP_HARD=200
DEVLAB_XP_EXPERT=500
DEVLAB_XP_DAILY_BONUS=25

# ── Rate limits (requests per minute) ─────────────────────────────────────────
DEVLAB_RATELIMIT_AUTH=5
DEVLAB_RATELIMIT_ATTEMPT_START=20
DEVLAB_RATELIMIT_SUBMISSION=30
DEVLAB_RATELIMIT_BORED=30
DEVLAB_RATELIMIT_REPORT=5
DEVLAB_RATELIMIT_AI=10
DEVLAB_RATELIMIT_COMMUNITY=5

# ── AI (Phase 5 — leave disabled until then) ──────────────────────────────────
# Provider is abstracted; an ADR must record the choice before enabling. AI_API_KEY is a
# placeholder — no config reads it until the provider lands in config/services.php.
AI_ENABLED=false
AI_PROVIDER=
AI_API_KEY=
AI_CHAT_MODEL=
AI_MAX_TOKENS_PER_REQUEST=2000
AI_USER_DAILY_TOKEN_QUOTA=50000

# ── Embeddings / RAG (Phase 6) ────────────────────────────────────────────────
# Do not set a dimension before an ADR chooses the model — a wrong guess means
# re-embedding the entire corpus (plan §28).
EMBEDDING_ENABLED=false
EMBEDDING_PROVIDER=
EMBEDDING_MODEL=
EMBEDDING_DIMENSIONS=

# ── Execution (Phase 3) ───────────────────────────────────────────────────────
# Runs player-submitted code. Architecture: ADR 0007 and ADR 0008. Threats and
# controls: docs/security/sandbox-threat-model.md.
#
# OFF by default, and it should stay off until you have read that document. With
# it off the container binds an orchestrator that REFUSES: Code Arena still
# loads, its runs come back unavailable, and no attempt is ever failed for it.
# Turning it on also needs the `execution` compose profile, which is what starts
# the orchestrator.
DEVLAB_EXECUTION_ENABLED=false
DEVLAB_ORCHESTRATOR_URL=http://orchestrator:8090

# Which container runtime the orchestrator asks for. Empty means the Docker
# default (`runc`), which is a MATERIALLY WEAKER boundary than gVisor — S1 in the
# threat model is the control that depends on this. Set it to `runsc` on a host
# that has gVisor installed. The orchestrator reports what it actually got on
# /health, so a deployment never has to guess.
SANDBOX_RUNTIME=

# Enforced by the sandbox; the orchestrator holds a second, longer deadline.
DEVLAB_EXECUTION_TIMEOUT=10
DEVLAB_EXECUTION_MEMORY_MB=256
DEVLAB_EXECUTION_CPU=0.5
DEVLAB_EXECUTION_PIDS=64
DEVLAB_EXECUTION_TMPFS_MB=16
DEVLAB_EXECUTION_OUTPUT_BYTES=65536

# How long a container may take to exist before its code starts. Tens of
# milliseconds on a Linux host; measured at ~12 seconds on Docker Desktop, which
# is longer than a submission is allowed to run — so it is separate from the
# timeout above rather than folded into it.
DEVLAB_EXECUTION_OVERHEAD=60

# Three different limits answering three different questions: how many runs a
# user holds at once, how fast they may start them, and how many one attempt may
# ever spend.
DEVLAB_EXECUTION_PER_USER=2
DEVLAB_RATELIMIT_EXECUTION=12
DEVLAB_EXECUTION_RUNS_PER_ATTEMPT=25

# ── AWS (unused today; kept for future object storage) ────────────────────────
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# ── Frontend ──────────────────────────────────────────────────────────────────
VITE_APP_NAME="${APP_NAME}"
